From 348317672ba7a7fa366c493a9372ad63303b1361 Mon Sep 17 00:00:00 2001
From: mojyack <mojyack.shadow@gmail.com>
Date: Mon, 28 Sep 2026 10:50:24 +0900
Subject: [PATCH 5/5] avcodec/v4l2_request_vp9: keep the frame pool across a
 mid-stream shrink

A stateless V4L2 decoder that sets V4L2_FMT_FLAG_DYN_RESOLUTION on its
coded format decodes a frame of any supported size up to the size of the
OUTPUT format into the CAPTURE buffers allocated for it, and those
buffers hold the references a VP9 frame of a new size predicts from.
Implement reuse_frames() for VP9 so such a stream keeps them instead of
renegotiating the format, as long as VIDIOC_ENUM_FRAMESIZES admits the
new size, step included, and keep renegotiating on a decoder without the
flag, e.g. rkvdec, which refuses a frame whose aligned size differs from
the format.

The flag on a stateless decoder is proposed for Linux in "media: docs:
Let stateless decoders set V4L2_FMT_FLAG_DYN_RESOLUTION", with the
Tegra210 NVDEC decoder setting it.

On that decoder VP9-TEST-VECTORS goes from 201 to 222 byte-exact
vectors, the resize_inter vectors and keyframe resizes that grow back
within the first allocation among them; without the flag on the same
decoder every resize renegotiates and the result is the 201 of before.

Assisted-by: Claude:claude-opus-5
---
 libavcodec/v4l2_request.c     | 55 +++++++++++++++++++++++++++++++++++
 libavcodec/v4l2_request.h     |  2 ++
 libavcodec/v4l2_request_vp9.c |  1 +
 3 files changed, 58 insertions(+)

diff --git a/libavcodec/v4l2_request.c b/libavcodec/v4l2_request.c
index 135b4ca8ce..29e020d0c4 100644
--- a/libavcodec/v4l2_request.c
+++ b/libavcodec/v4l2_request.c
@@ -597,6 +597,61 @@ int ff_v4l2_request_continue_frame(AVCodecContext *avctx,
     return v4l2_request_start(avctx, pic, frame, false);
 }
 
+int ff_v4l2_request_reuse_frames(AVCodecContext *avctx, int width, int height)
+{
+    V4L2RequestContext *ctx = v4l2_request_context(avctx);
+    const struct v4l2_format *format = &ctx->fctxi->output.format;
+    struct v4l2_fmtdesc fmtdesc = {
+        .type = format->type,
+    };
+    struct v4l2_frmsizeenum frmsize = { 0 };
+    uint32_t pixelformat;
+
+    if (V4L2_TYPE_IS_MULTIPLANAR(format->type)) {
+        if (width > format->fmt.pix_mp.width || height > format->fmt.pix_mp.height)
+            return 0;
+        pixelformat = format->fmt.pix_mp.pixelformat;
+    } else {
+        if (width > format->fmt.pix.width || height > format->fmt.pix.height)
+            return 0;
+        pixelformat = format->fmt.pix.pixelformat;
+    }
+    frmsize.pixel_format = pixelformat;
+
+    // A stateless decoder sets DYN_RESOLUTION when it decodes any supported
+    // frame size up to the coded format into the allocated CAPTURE buffers
+    while (ioctl(ctx->fctxi->video_fd, VIDIOC_ENUM_FMT, &fmtdesc) >= 0) {
+        if (fmtdesc.pixelformat == pixelformat)
+            break;
+        fmtdesc.index++;
+    }
+    if (fmtdesc.pixelformat != pixelformat ||
+        !(fmtdesc.flags & V4L2_FMT_FLAG_DYN_RESOLUTION))
+        return 0;
+
+    // Frame sizes are unrestricted when ENUM_FRAMESIZES is not supported
+    if (ioctl(ctx->fctxi->video_fd, VIDIOC_ENUM_FRAMESIZES, &frmsize) < 0)
+        return 1;
+    do {
+        if (frmsize.type == V4L2_FRMSIZE_TYPE_DISCRETE) {
+            if (width == frmsize.discrete.width && height == frmsize.discrete.height)
+                return 1;
+        } else if (width >= frmsize.stepwise.min_width &&
+                   height >= frmsize.stepwise.min_height &&
+                   width <= frmsize.stepwise.max_width &&
+                   height <= frmsize.stepwise.max_height &&
+                   (width - frmsize.stepwise.min_width) %
+                   FFMAX(frmsize.stepwise.step_width, 1) == 0 &&
+                   (height - frmsize.stepwise.min_height) %
+                   FFMAX(frmsize.stepwise.step_height, 1) == 0) {
+            return 1;
+        }
+        frmsize.index++;
+    } while (ioctl(ctx->fctxi->video_fd, VIDIOC_ENUM_FRAMESIZES, &frmsize) >= 0);
+
+    return 0;
+}
+
 void ff_v4l2_request_flush(AVCodecContext *avctx)
 {
     V4L2RequestContext *ctx = v4l2_request_context(avctx);
diff --git a/libavcodec/v4l2_request.h b/libavcodec/v4l2_request.h
index 9bb0454c83..d9711d327f 100644
--- a/libavcodec/v4l2_request.h
+++ b/libavcodec/v4l2_request.h
@@ -95,6 +95,8 @@ int ff_v4l2_request_continue_frame(AVCodecContext *avctx,
                                    V4L2RequestPictureContext *pic,
                                    AVFrame *frame);
 
+int ff_v4l2_request_reuse_frames(AVCodecContext *avctx, int width, int height);
+
 void ff_v4l2_request_flush(AVCodecContext *avctx);
 
 int ff_v4l2_request_frame_params(AVCodecContext *avctx,
diff --git a/libavcodec/v4l2_request_vp9.c b/libavcodec/v4l2_request_vp9.c
index e93937daf2..dd5a5bcaa6 100644
--- a/libavcodec/v4l2_request_vp9.c
+++ b/libavcodec/v4l2_request_vp9.c
@@ -526,5 +526,6 @@ const FFHWAccel ff_vp9_v4l2request_hwaccel = {
     .uninit             = ff_v4l2_request_uninit,
     .priv_data_size     = sizeof(V4L2RequestContextVP9),
     .frame_params       = v4l2_request_vp9_frame_params,
+    .reuse_frames       = ff_v4l2_request_reuse_frames,
     .caps_internal      = HWACCEL_CAP_ASYNC_SAFE,
 };
