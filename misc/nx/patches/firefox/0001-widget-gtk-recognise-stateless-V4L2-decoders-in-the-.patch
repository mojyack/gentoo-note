From a176e56a27ec9db219070b684f3ad1368e5b5e76 Mon Sep 17 00:00:00 2001
From: mojyack <mojyack@gmail.com>
Date: Mon, 24 Aug 2026 08:26:10 +0000
Subject: [PATCH 1/3] widget/gtk: recognise stateless V4L2 decoders in the
 GfxInfo probe

V4L2ProbeDevice() decides a device can decode a codec by looking for the
coded fourcc on its OUTPUT queue - H264, VP80, VP90, HEVC, AV01.  Only a
stateful decoder advertises those.  A stateless one takes parsed slices
and advertises the frame or slice format instead - S264, VP8F, VP9F,
S265, AV1F - so every stateless device probed as unsupported, whatever
FFmpeg could do with it.

Accept both spellings.  Which of the two a device is does not matter
here: the decision this function makes is only whether the codec is
hardware-decodable, and InitV4L2Decoder() picks the FFmpeg decoder that
matches.

Assisted-by: Claude (claude-opus-5)
---
 widget/gtk/GfxInfo.cpp | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/widget/gtk/GfxInfo.cpp b/widget/gtk/GfxInfo.cpp
index cac1557e2f59..90f1f793bf58 100644
--- a/widget/gtk/GfxInfo.cpp
+++ b/widget/gtk/GfxInfo.cpp
@@ -971,28 +971,32 @@ void GfxInfo::V4L2ProbeDevice(nsCString& dev) {
     return;
   }
 
-  // Supported codecs
-  if (outFormats.Contains("H264")) {
+  // Supported codecs.  A stateful decoder advertises the coded format itself
+  // (H264, VP80, ...) and is driven by an FFmpeg *_v4l2m2m wrapper decoder; a
+  // stateless one advertises the frame/slice format (S264, VP8F, ...) and is
+  // driven by FFmpeg's software parser plus the V4L2 request API hwaccel.
+  // Either is usable, so accept both spellings.
+  if (outFormats.Contains("H264") || outFormats.Contains("S264")) {
     mIsV4L2Supported = Some(true);
     media::MCSInfo::AddSupport(media::MediaCodecsSupport::H264HardwareDecode);
     mV4L2SupportedCodecs |= CODEC_HW_DEC_H264;
   }
-  if (outFormats.Contains("VP80")) {
+  if (outFormats.Contains("VP80") || outFormats.Contains("VP8F")) {
     mIsV4L2Supported = Some(true);
     media::MCSInfo::AddSupport(media::MediaCodecsSupport::VP8HardwareDecode);
     mV4L2SupportedCodecs |= CODEC_HW_DEC_VP8;
   }
-  if (outFormats.Contains("VP90")) {
+  if (outFormats.Contains("VP90") || outFormats.Contains("VP9F")) {
     mIsV4L2Supported = Some(true);
     media::MCSInfo::AddSupport(media::MediaCodecsSupport::VP9HardwareDecode);
     mV4L2SupportedCodecs |= CODEC_HW_DEC_VP9;
   }
-  if (outFormats.Contains("HEVC")) {
+  if (outFormats.Contains("HEVC") || outFormats.Contains("S265")) {
     mIsV4L2Supported = Some(true);
     media::MCSInfo::AddSupport(media::MediaCodecsSupport::HEVCHardwareDecode);
     mV4L2SupportedCodecs |= CODEC_HW_DEC_HEVC;
   }
-  if (outFormats.Contains("AV01")) {
+  if (outFormats.Contains("AV01") || outFormats.Contains("AV1F")) {
     mIsV4L2Supported = Some(true);
     media::MCSInfo::AddSupport(media::MediaCodecsSupport::AV1HardwareDecode);
     mV4L2SupportedCodecs |= CODEC_HW_DEC_AV1;
