#!/bin/bash

if swaymsg -t get_outputs | grep transform | grep -q 180; then
    rot=270
    config=config-landscape
else
    rot=180
    config=config
fi

pid=$(pgrep -u $USER -x swaybarpp)
swaymsg "output DSI-1 transform $rot; exec_always swaybarpp ~/.config/swaybarpp/$config.json"

if ! [[ -z $pid ]]; then
    kill $pid # this may kill us, do at very last
fi
